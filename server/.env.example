# Copy to .env and fill in. Never commit .env.
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>
DB_NAME=online_bookstore

# Origin of the React dev server (used for CORS)
CORS_ORIGIN=http://localhost:5173

# Temporary stand-in for sign-in until issue #1 (authentication) lands.
# true = trust an "X-Dev-User-Id: <customers.id>" request header. Local development only!
ALLOW_DEV_AUTH=false

# Payment gateway (used by the payment module)
PAYMENT_API_KEY=
PAYMENT_SECRET=
