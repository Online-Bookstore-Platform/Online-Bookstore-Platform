PORT=5000
# Required in production; the development server generates a temporary session secret if omitted.
SESSION_SECRET=
# Optional absolute or cwd-relative JS module exporting createVarchasAdapters() for DB/service adapters.
VARCHAS_ADAPTER_MODULE=
# Select "mock" only for a clearly labeled sandbox demonstration; the mock never contacts a gateway.
PAYMENT_PROVIDER=
PAYMENT_MOCK_RESULT=declined
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional origins permitted by a future cross-origin deployment; same-origin Vite proxy is used locally.
