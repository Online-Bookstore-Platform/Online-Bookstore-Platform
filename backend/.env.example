PORT=5000
# Required in production; the development server generates a temporary session secret if omitted.
SESSION_SECRET=
# Explicit localhost-only password-reset link for development when email is unavailable.
DEV_PASSWORD_RESET_LINK=false
# Optional absolute or cwd-relative JS module exporting createVarchasAdapters() for DB/service adapters.
VARCHAS_ADAPTER_MODULE=
# Internal checkout outcome for local flow verification; no payment gateway is used.
# Values: approved, declined, cancelled, timeout.
FOLIO_CHECKOUT_OUTCOME=approved
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional: connection pool size (default 10).
DB_POOL_SIZE=
# Optional Open Library client identification (include a monitored contact in deployment config).
OPEN_LIBRARY_USER_AGENT=
# Google Books requires an API key for public Volumes API requests; used only if Open Library is unavailable.
GOOGLE_BOOKS_API_KEY=
# Local presentation store only. Must remain false/unset in production.
CATALOGUE_DEMO_MODE=false
CATALOGUE_DEMO_PRICE_MIN=199
CATALOGUE_DEMO_PRICE_MAX=999
CATALOGUE_DEMO_INITIAL_STOCK=10
# Optional, local demos only: lets the three seeded demo accounts sign in (8+ characters).
# Used only by `npm run db:reset` / `db:setup -- --seed`; never set it on a real deployment.
SEED_DEMO_PASSWORD=
# Optional origins permitted by a future cross-origin deployment; same-origin Vite proxy is used locally.
