{
  "name": "online-bookstore-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --env-file=.env --test",
    "db:setup": "node --env-file=.env database/setup.js",
    "email:verify": "node --env-file=.env scripts/verify-email.js",
    "db:reset": "node --env-file=.env database/setup.js --reset",
    "reviews:seed": "node --env-file=.env database/seed-demo-reviews.js",
    "reviews:clear": "node --env-file=.env database/seed-demo-reviews.js --clear"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1"
  }
}
